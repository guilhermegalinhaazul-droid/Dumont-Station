<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <WarningsAsErrors>RA0032;nullable</WarningsAsErrors>
  </PropertyGroup>
  <Import Project="../MSBuild/Content.props" />
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <Import Project="..\RobustToolbox\Imports\Lidgren.props" />
  <Import Project="..\RobustToolbox\Imports\Shared.props" />

  <ItemGroup>
    <ProjectReference Include="..\Content.Goobstation.Common\Content.Goobstation.Common.csproj" />
    <ProjectReference Include="..\Content.Goobstation.Maths\Content.Goobstation.Maths.csproj" />
    <ProjectReference Include="..\Content.Shared.Database\Content.Shared.Database.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Goobstation\Changeling\Changeling.Actions.cs" />
    <Folder Include="_Starlight\Movement\" />
    <Folder Include="Power\Components\" />
    <Folder Include="_Starlight\Spells\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hybrid Genetics: compile only the imported Trauma genetics engine into Content.Shared.
         This avoids a circular/full project reference to Content.Trauma.Shared while keeping
         the existing MutationSystem/prototype namespaces as the single implementation. -->
    <Compile Include="..\Content.Trauma.Shared\Genetics\Mutations\*.cs"
             Exclude="..\Content.Trauma.Shared\Genetics\Mutations\BodySystem.cs;..\Content.Trauma.Shared\Genetics\Mutations\CommonMutationSystem.cs;..\Content.Trauma.Shared\Genetics\Mutations\MutationRelaySystem.cs"
             Link="_Wega\Genetics\Trauma\Mutations\%(Filename)%(Extension)" />
    <Compile Include="..\Content.Trauma.Shared\Genetics\Abilities\*.cs"
             Exclude="..\Content.Trauma.Shared\Genetics\Abilities\MindReadActionSystem.cs;..\Content.Trauma.Shared\Genetics\Abilities\BleedingMutationSystem.cs;..\Content.Trauma.Shared\Genetics\Abilities\ChemSpikeMutationSystem.cs;..\Content.Trauma.Shared\Genetics\Abilities\InjectChemicalsActionSystem.cs;..\Content.Trauma.Shared\Genetics\Abilities\MetabolismSpeedMutationSystem.cs;..\Content.Trauma.Shared\Genetics\Abilities\TemperatureDamageMutationSystem.cs;..\Content.Trauma.Shared\Genetics\Abilities\RadioMutationSystem.cs"
             Link="_Wega\Genetics\Trauma\Abilities\%(Filename)%(Extension)" />
    <Compile Include="..\Content.Trauma.Shared\Actions\ActionProjectileComponent.cs"
             Link="_Wega\Genetics\Trauma\Actions\ActionProjectileComponent.cs" />

    <Compile Update="_Starlight\OnHit\CuffsOnHitComponent.cs" />
    <Compile Update="_Starlight\OnHit\InjectOnHitComponent.cs" />
    <Compile Update="_Starlight\Weapon\Components\GunComponent.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <Import Project="..\RobustToolbox\MSBuild\Robust.Properties.targets" />
  <Import Project="..\RobustToolbox\MSBuild\Robust.CompNetworkGenerator.targets" />
</Project>
